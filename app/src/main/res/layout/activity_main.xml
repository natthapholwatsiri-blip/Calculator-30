<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#000A31"
    android:padding="16dp">

<!--    หน้าจอแสดงผล-->
    <TextView
        android:id="@+id/txtDisplay"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="0"
        android:padding="16dp"
        android:textColor="@color/black"
        android:gravity="end"
        android:background="#FFFFFF"
        android:layout_marginBottom="12dp"
        android:textSize="36sp"
        />

<!--    โซนปุ่ม-->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:padding="8dp"
        android:background="#2E427A"
        >

        <!--แถวที่1    -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal">

<!--            แต่ละปุ่ม-->
            <Button
                android:id="@+id/btnAC"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="AC"
                android:textSize="18dp"
                android:layout_margin="4dp"
                android:backgroundTint="#142B4E"
                android:textColor="@color/white"
                />
            <Button
                android:id="@+id/btnDel"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="DEL"
                android:textSize="18dp"
                android:layout_margin="4dp"
                android:backgroundTint="#142B4E"
                android:textColor="@color/white"
                />
            <Button
                android:id="@+id/btnMod"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="%"
                android:textSize="18dp"
                android:layout_margin="4dp"
                android:backgroundTint="#142B4E"
                android:textColor="@color/white"
                />
            <Button
                android:id="@+id/btnDiv"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="÷"
                android:textSize="18dp"
                android:layout_margin="4dp"
                android:backgroundTint="#142B4E"
                android:textColor="@color/white"
                />

        </LinearLayout>
        <!--แถวที่2-->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal">

            <!--            แต่ละปุ่ม-->
            <Button
                android:id="@+id/btn7"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="7"
                android:textSize="18dp"
                android:layout_margin="4dp"
                android:backgroundTint="#88ABE2"

                />
            <Button
                android:id="@+id/btn8"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="8"
                android:textSize="18dp"
                android:layout_margin="4dp"
                android:backgroundTint="#88ABE2"
                />
            <Button
                android:id="@+id/btn9"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="9"
                android:textSize="18dp"
                android:layout_margin="4dp"
                android:backgroundTint="#88ABE2"
                />
            <Button
                android:id="@+id/btnMu"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="×"
                android:textSize="18dp"
                android:layout_margin="4dp"
                android:backgroundTint="#142B4E"
                android:textColor="@color/white"
                />

        </LinearLayout>
        <!--แถวที่3-->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal">

            <!--            แต่ละปุ่ม-->
            <Button
                android:id="@+id/btn4"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="4"
                android:textSize="18dp"
                android:layout_margin="4dp"
                android:backgroundTint="#88ABE2"
                />
            <Button
                android:id="@+id/btn5"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="5"
                android:textSize="18dp"
                android:layout_margin="4dp"
                android:backgroundTint="#88ABE2"
                />
            <Button
                android:id="@+id/btn6"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="6"
                android:textSize="18dp"
                android:layout_margin="4dp"
                android:backgroundTint="#88ABE2"
                />
            <Button
                android:id="@+id/btnre"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="-"
                android:textSize="18dp"
                android:layout_margin="4dp"
                android:backgroundTint="#142B4E"
                android:textColor="@color/white"
                />

        </LinearLayout>
        <!--แถวที่4-->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal">

            <!--            แต่ละปุ่ม-->
            <Button
                android:id="@+id/btn1"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="1"
                android:textSize="18dp"
                android:layout_margin="4dp"
                android:backgroundTint="#88ABE2"
                />
            <Button
                android:id="@+id/btn2"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="2"
                android:textSize="18dp"
                android:layout_margin="4dp"
                android:backgroundTint="#88ABE2"
                />
            <Button
                android:id="@+id/btn3"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="3"
                android:textSize="18dp"
                android:layout_margin="4dp"
                android:backgroundTint="#88ABE2"
                />
            <Button
                android:id="@+id/btnSum"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="+"
                android:textSize="18dp"
                android:layout_margin="4dp"
                android:backgroundTint="#142B4E"
                android:textColor="@color/white"
                />

        </LinearLayout>
        <!--แถวที่5-->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal">

            <!--            แต่ละปุ่ม-->
            <Button
                android:id="@+id/btnReSum"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="±"
                android:textSize="18dp"
                android:layout_margin="4dp"
                android:backgroundTint="#142B4E"
                android:textColor="@color/white"
                />
            <Button
                android:id="@+id/btn0"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="0"
                android:textSize="18dp"
                android:layout_margin="4dp"
                android:backgroundTint="#88ABE2"
                />
            <Button
                android:id="@+id/btnPo"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="."
                android:textSize="18dp"
                android:layout_margin="4dp"
                android:backgroundTint="#142B4E"
                android:textColor="@color/white"
                />
            <Button
                android:id="@+id/btnME"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="="
                android:textSize="18dp"
                android:layout_margin="4dp"
                android:backgroundTint="#142B4E"
                android:textColor="@color/white"
                />

        </LinearLayout>
    </LinearLayout>
</LinearLayout>